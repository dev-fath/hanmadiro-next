// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(50)
  password      String
  loginAttempts Int       @default(0)
  lockedUntil   DateTime? @db.Timestamp
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  pushTokens    PushToken[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @db.Text @map("refresh_token")
  accessToken       String? @db.Text @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @db.Text @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PushToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String?  @map("user_id")
  isValid    Boolean  @default(true) @map("is_valid")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  messageAssignments  MessageAssignment[]
  pushLogs            PushLog[]

  @@map("push_tokens")
}

model Message {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(255)
  body      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messageAssignments MessageAssignment[]
  pushLogs           PushLog[]

  @@map("messages")
}

model MessageAssignment {
  id          String    @id @default(uuid())
  pushTokenId String    @map("push_token_id")
  messageId   String    @map("message_id")
  sentAt      DateTime? @map("sent_at")
  status      AssignmentStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pushToken PushToken @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_assignments")
}

model PushLog {
  id          String   @id @default(uuid())
  pushTokenId String   @map("push_token_id")
  messageId   String   @map("message_id")
  sentAt      DateTime @map("sent_at")
  success     Boolean
  errorMessage String? @db.Text @map("error_message")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pushToken PushToken @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("push_logs")
}

model CronJobLog {
  id              String   @id @default(uuid())
  jobName         String   @map("job_name")
  executedAt      DateTime @map("executed_at")
  status          JobStatus
  errorMessage    String?  @db.Text @map("error_message")
  executionTimeMs Int?     @map("execution_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cron_job_logs")
}

enum AssignmentStatus {
  PENDING
  SENT
  FAILED
}

enum JobStatus {
  SUCCESS
  FAILED
}

